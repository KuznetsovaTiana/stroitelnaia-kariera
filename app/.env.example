# SERVER ONLY. Copy to app/.env.local for npm run dev. Never use a VITE_ prefix.
# Default is live, including production; no credentials => unavailable, never silent mock.
AI_MODE=live
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Optional additional trusted CA PEM from the official GigaChat certificate documentation.
# In Netlify use a multiline Functions environment variable. TLS verification stays enabled.
GIGACHAT_CA_PEM=
# Optional exact additional origins, separated by commas. Same origin is allowed automatically.
AI_ALLOWED_ORIGINS=
